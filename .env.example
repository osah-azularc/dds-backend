# =============================================================================
# DDS backend — environment configuration (template)
# Copy to `.env` for local development. Loaded by bootstrap.js when NODE_ENV=local
# (the "local" npm scripts set this for you). Non-local environments pull these
# from AWS Secrets Manager instead — see config/runtimeConfig.js.
#
# This backend currently only mounts /user and /api/auth (login/logout/session).
# Everything below is what those routes actually need to boot.
# =============================================================================

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=change-me

# --- Server ---
APP_PORT=9001
APP_URL=http://localhost:3000/

# --- Auth / tokens ---
# Most-referenced secret in the codebase — signs/verifies JWTs.
TOKEN_SECRET=change-me
# Falls back to TOKEN_SECRET if unset.
# REFRESH_TOKEN_SECRET=
USER_SECRET=change-me
# Signs express-session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

ACCESS_TOKEN_EXPIRES=60m
REFRESH_TOKEN_EXPIRES=7d

# --- Account lockout (accountLockout.js) ---
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# --- AWS (only used by S3 profile-file helpers pulled in via /user routes) ---
# Defaults to us-east-1 locally if left unset; only matters if you actually
# exercise the S3-backed profile file endpoints.
AWS_REGION=us-east-1
