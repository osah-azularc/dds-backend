<%# Rendered at two different font sizes by page one (18px/16px) vs page two (15px/14px) -
    a genuine inconsistency in legacy itself (InvoiceModel::getPdfFirstPage vs
    generateAttachment), not a copy/paste slip on this side. %>
<table cellpadding="0" cellspacing="0" width="100%" class="footer-table">
  <tr>
    <td>
      <div class="footer-heading" style="font-size: <%= headingSize %>px;">Remit to:</div>
      <div class="footer-body" style="font-size: <%= bodySize %>px;"><%= remitInformation %></div>
    </td>
    <td class="tax-col">
      <div class="footer-heading" style="font-size: <%= headingSize %>px;">&nbsp;</div>
      <div class="footer-body" style="font-size: <%= bodySize %>px;"><%= taxInformation %></div>
    </td>
  </tr>
</table>
